#!/usr/sbin/nft -f
# fw-borde · referencia del BLOQUE B (nivel completo: un prefijo por regla de denegación)
table inet borde
delete table inet borde

table inet borde {
    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        # 10 · internet → tienda-01 :443
        ip saddr 203.0.113.0/24 ip daddr 192.168.10.10 tcp dport 443 accept
        # 20 · tienda-01 → erp-prod :1433
        ip saddr 192.168.10.10 ip daddr 192.168.20.10 tcp dport 1433 accept
        # 30 · usuarios → erp-prod :1433
        ip saddr 192.168.30.0/24 ip daddr 192.168.20.10 tcp dport 1433 accept
        # 40 · tienda-01 → api-pagos :443
        ip saddr 192.168.10.10 ip daddr 203.0.113.50 tcp dport 443 accept

        # 50 · SMB desde la DMZ: se deniega Y se registra con su propio nombre
        ip saddr 192.168.10.0/24 ip daddr 192.168.20.0/24 tcp dport 445 \
            log prefix "CT-DENY-SMB " counter drop

        # 90 · todo lo demás: se registra antes de caer por política
        log prefix "CT-DENY-DEFAULT " counter
    }
    chain input  { type filter hook input  priority 0; policy accept; }
    chain output { type filter hook output priority 0; policy accept; }
}
