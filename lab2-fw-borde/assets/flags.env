# ═════════════════════════════════════════════════════════════════════════
#  BANDERAS DEL LAB 2 · Cóndor Tech · Módulo 4 CIBER13
# ═════════════════════════════════════════════════════════════════════════
#
#  ESTAS BANDERAS YA ESTÁN LISTAS. No hay que inventar nada.
#  Solo se cambian si algún día reutilizas el lab con otra cohorte:
#  en ese caso, cambia el bloque de seis letras y números del final
#  de cada una y vuelve a cargarlas en CTFd.
#
#  Estructura:   CT{ lab2 · bloque · nivel · token }
#                     └ de qué lab    └ qué logró   └ para que no se adivine
#
#  Cada bandera corresponde a UN reto de CTFd, en la categoría "Lab 2",
#  con el mismo nombre corto que se declara abajo.
#  Carga: CTFd_Lab2_Retos.csv  ·  referencia: CTFd_Lab2_Hoja_de_Carga.md
#
#  Quien alcanza el nivel completo recibe DOS banderas: la del mínimo
#  (o la de rescate) y además la de completo. Los puntos se suman.
# ═════════════════════════════════════════════════════════════════════════

CT_CATEGORIA='Lab 2'

# ── BLOQUE A · la política del equipo cruzando fw-borde ──────────────────
CT_FLAG_A_MIN='CT{lab2A_minimo_83654c}'
CT_RETO_A_MIN='A Mínimo'

CT_FLAG_A_RESCATE='CT{lab2A_rescate_bfc8a7}'
CT_RETO_A_RESCATE='A Rescate'

CT_FLAG_A_FULL='CT{lab2A_completo_7d5650}'
CT_RETO_A_FULL='A Completo'

# ── BLOQUE B · el registro de denegados ──────────────────────────────────
CT_FLAG_B_MIN='CT{lab2B_minimo_c70a29}'
CT_RETO_B_MIN='B Mínimo'

