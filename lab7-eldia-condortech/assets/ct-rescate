#!/bin/bash
source /opt/ct/ct-lib.sh; ct_espera
case "$1" in
 A|a) echo -e "${Y}Rescate del Bloque A — método completo, con cada comando:${N}"
  echo "1) ¿Quién hizo clic?     grep -i helpdesk /srv/evidencias/proxy-access.log | head -3        → una sola IP de estación: 10.10.30.17"
  echo "2) ¿Qué equipo es?       ct-eventos 4624 | grep 10.10.30.17                                  → WorkstationName"
  echo "3) ¿Qué cuenta entró?    grep 'Accepted' /srv/evidencias/srv-erp-auth.log | grep 10.10.30.17 → la cuenta"
  echo "4) ¿A dónde llama?       grep CONNECT /srv/evidencias/proxy-access.log | awk '{print \$7}' | sort | uniq -c"
  echo "5) ¿Cómo se llama la nota? ls /srv/erp | grep -v condor"
  echo; echo "Las banderas 13.1–13.4 siguen disponibles con ct-responder; el rescate solo entrega esta:"; ct_otorga ares;;
 B|b) echo -e "${Y}Rescate del Bloque B — secuencia completa:${N}"
  echo "  ct-cronometro"; echo "  restic -r /srv/respaldo/erp snapshots            # te pide la llave de la Clase 12"; echo "  restic -r /srv/respaldo/erp restore latest --target /srv/restaurado"; echo "  ct-rto                                            # valida hashes, mide RTO, certifica"
  echo; echo "El escenario NO tiene la llave: sin llave no hay restauración ni certificado (eso también se registra en la Bitácora)."; ct_otorga bres;;
 *) echo "Uso: ct-rescate A | B";;
esac
