#!/bin/bash
source /opt/ct/ct-lib.sh; ct_espera
T=$(date +%s); H=/opt/ct/hashes-erp.txt
base=""; for cand in /srv/restaurado/srv/erp /srv/restaurado /srv/erp; do
  [ -f "$cand/clientes.csv" ] && { base=$cand; break; }; done
[ -z "$base" ] && { echo -e "${R}No encuentro archivos restaurados. ¿Corriste restic restore ... --target /srv/restaurado con la llave correcta?${N}"; echo "Sin llave no hay restauración. ct-pista b"; exit 1; }
ok=0; tot=0; malos=""
while read h f; do tot=$((tot+1)); if [ -f "$base/$f" ] && [ "$(sha256sum "$base/$f" | cut -d' ' -f1)" = "$h" ]; then ok=$((ok+1)); else malos="$malos $f"; fi; done < $H
echo -e "${B}Validación de integridad:${N} $ok/$tot archivos coinciden con el hash conocido ($base)"
[ -n "$malos" ] && echo -e "${R}No coinciden:$malos${N}"
if [ -f /root/.ct-t0 ]; then rto=$(( T - $(cat /root/.ct-t0) )); rtotxt="$((rto/60)) min $((rto%60)) s"; else rtotxt="no medido (no se corrió ct-cronometro)"; fi
echo -e "${B}RTO medido:${N} $rtotxt"
if [ $ok -eq $tot ] && [ $tot -gt 0 ]; then
  cert=/root/certificado-restauracion-eldia.txt
  { echo "CERTIFICADO DE RESTAURACIÓN VALIDADA — EL DÍA (Lab 7, Clase 13)"; echo "Cóndor Tech S.A.S. · repositorio /srv/respaldo/erp · snapshot: latest"; echo "Fecha/hora: $(date '+%Y-%m-%d %H:%M:%S %Z')"; echo "Archivos validados: $ok/$tot (SHA-256 iguales al original)"; echo "RTO: $rtotxt"; echo "Código: $(printf '%s%s' "$ok" "$T" | sha256sum | cut -c1-12)"; } > $cert
  echo; cat $cert; echo; echo -e "${G}Guardado en $cert — el Líder lo pega en la Bitácora (restauración validada, 0–2 pts).${N}"; ct_otorga b1
else echo -e "${Y}Restauración incompleta: sin certificado. Revisa la llave o el --target.${N}"; fi
