#!/bin/bash
# Lab 6 · Cóndor Tech · herramienta del escenario
EST=/root/lab6/.estado; mkdir -p "$EST"
verde(){ printf "\033[32m%s\033[0m\n" "$*"; }; rojo(){ printf "\033[31m%s\033[0m\n" "$*"; }; amar(){ printf "\033[33m%s\033[0m\n" "$*"; }; azul(){ printf "\033[36m%s\033[0m\n" "$*"; }
F_A1="CT{l6-a-min-48b974}"; F_A2="CT{l6-a-com-53bde8}"; F_A3="CT{l6-a-ext-06979c}"; F_AR="CT{l6-a-res-9aa817}"
F_B1="CT{l6-b-min-8837f9}"; F_B2="CT{l6-b-com-756d2f}"; F_B3="CT{l6-b-ext-0f2024}"; F_BR="CT{l6-b-res-1415cc}"
cmd(){ if [ -t 1 ]; then printf "\033[36m  \$ %s\033[0m\n" "$*"; else printf "  \$ %s\n" "$*"; fi; }
guardar(){ grep -q "^$1=" "$EST/banderas" 2>/dev/null || echo "$1=$2" >> "$EST/banderas"; }
# escaneo: en Killercoda es trivy image; CT_MODO_FS=<dir> permite probar la lógica sin docker
escanear_json(){ # $1 = tag (legacy|v2)
  local tag="$1" out="/root/lab6/escaneo-$1.json"
  if [ -n "$CT_MODO_FS" ]; then trivy fs --scanners vuln --format json -q "$CT_MODO_FS/$tag" > "$out" 2>/dev/null
  else trivy image --scanners vuln --format json -q "carrito:$tag" > "$out" 2>/dev/null; fi
  echo "$out"
}

if [ -z "$CT_MODO_FS" ]; then
  echo "▶ Esto es lo que se ejecuta por debajo:"
  cmd "curl -s localhost:8080/   y   curl -s -X POST --data-binary 'prueba: 1' localhost:8080/importar"
  docker image inspect carrito:v2 >/dev/null 2>&1 || { rojo "✘ No existe carrito:v2 todavía. Edita /root/lab6/carrito/requirements.txt y ejecuta ct-construir"; exit 1; }
  if ! curl -s -m 3 localhost:8080/ | grep -q '"estado":"ok"'; then rojo "✘ El carrito no responde en el 8080: remediar no puede romper el servicio. docker logs carrito-v2"; exit 1; fi
  if ! curl -s -m 3 -X POST -H 'Content-Type: text/yaml' --data-binary 'prueba: 1' localhost:8080/importar | grep -q importados; then rojo "✘ POST /importar falló tras el cambio. docker logs carrito-v2"; exit 1; fi
fi
if [ -n "$CT_MODO_FS" ]; then cmd "trivy fs --scanners vuln --format json -o /root/lab6/escaneo-v2.json $CT_MODO_FS/v2"; else cmd "trivy image --scanners vuln --format json -o /root/lab6/escaneo-v2.json carrito:v2"; fi
J=$(escanear_json v2)
echo
python3 - "$J" "$F_B1" "$F_B2" "$F_B3" "$EST" <<'PY'
import json,sys,os
d=json.load(open(sys.argv[1])); fb1,fb2,fb3,est=sys.argv[2:6]
pk={}; cves=set()
for r in d.get('Results',[]):
    for v in r.get('Vulnerabilities',[]):
        pk.setdefault(v['PkgName'].lower(),[]).append(v['VulnerabilityID']); cves.add(v['VulnerabilityID'])
G="\033[32m%s\033[0m"; R="\033[31m%s\033[0m"; Y="\033[33m%s\033[0m"
def guardar(k,f):
    p=os.path.join(est,'banderas'); s=open(p).read() if os.path.exists(p) else ''
    if not any(l.startswith(k+'=') for l in s.splitlines()): open(p,'a').write(f"{k}={f}\n")
ok1 = not any(c.startswith('CVE-2020-14343') or c in('CVE-2020-1747','CVE-2019-20477') for c in cves) and 'pyyaml' not in pk
if ok1: print(G%"✔ B1 mínimo: PyYAML ya no tiene hallazgos y el servicio sigue respondiendo"); print(G%("   bandera B1: "+fb1)); guardar('B1',fb1)
else: print(R%"✘ B1: PyYAML sigue vulnerable (%s). Sube a PyYAML>=6.0 en requirements.txt y ct-construir" % ', '.join(pk.get('pyyaml',[])[:3])); sys.exit(1)
ok2 = 'CVE-2018-18074' not in cves
if ok2: print(G%"✔ B2 completo: CVE-2018-18074 cerrado (requests ≥ 2.20) y verificado con re-escaneo"); print(G%("   bandera B2: "+fb2)); guardar('B2',fb2)
else: print(Y%"   B2 pendiente: requests sigue en una versión que reenvía el token (CVE-2018-18074). ct-pista b2")
ok3 = 'pillow' not in pk
if ok2 and ok3: print(G%"✔ B3 extra: Pillow eliminado de la imagen — el hallazgo que no se parcha, se quita"); print(G%("   bandera B3: "+fb3)); guardar('B3',fb3)
elif ok2: print(Y%"   B3 pendiente (extra): quita la línea Pillow de requirements.txt y ct-construir")
PY
ok=$?
[ $ok -eq 0 ] && { echo; ct-formato queda "$J" v2; }
exit $ok
