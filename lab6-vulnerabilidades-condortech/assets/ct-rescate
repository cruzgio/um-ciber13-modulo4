#!/bin/bash
# Lab 6 · Cóndor Tech · herramienta del escenario
EST=/root/lab6/.estado; mkdir -p "$EST"
verde(){ printf "\033[32m%s\033[0m\n" "$*"; }; rojo(){ printf "\033[31m%s\033[0m\n" "$*"; }; amar(){ printf "\033[33m%s\033[0m\n" "$*"; }; azul(){ printf "\033[36m%s\033[0m\n" "$*"; }
F_A1="CT{l6-a-min-48b974}"; F_A2="CT{l6-a-com-53bde8}"; F_A3="CT{l6-a-ext-06979c}"; F_AR="CT{l6-a-res-9aa817}"
F_B1="CT{l6-b-min-8837f9}"; F_B2="CT{l6-b-com-756d2f}"; F_B3="CT{l6-b-ext-0f2024}"; F_BR="CT{l6-b-res-1415cc}"
guardar(){ grep -q "^$1=" "$EST/banderas" 2>/dev/null || echo "$1=$2" >> "$EST/banderas"; }
# escaneo: en Killercoda es trivy image; CT_MODO_FS=<dir> permite probar la lógica sin docker
escanear_json(){ # $1 = tag (legacy|v2)
  local tag="$1" out="/root/lab6/escaneo-$1.json"
  if [ -n "$CT_MODO_FS" ]; then trivy fs --scanners vuln --format json -q "$CT_MODO_FS/$tag" > "$out" 2>/dev/null
  else trivy image --scanners vuln --format json -q "carrito:$tag" > "$out" 2>/dev/null; fi
  echo "$out"
}

case "$1" in
 A) cat <<'EOF'
Rescate A · Top 5 de Cóndor Tech, razonado (esto es lo que tú debías construir):
  1. CVE-2020-14343  PyYAML 5.3.1   RCE desde internet sin credenciales, exploit público  → corregir YA
  2. CVE-2018-18074  requests 2.19  fuga del token de pagos si la pasarela redirige       → corregir esta semana
  3. CVE-2024-1135   gunicorn 19.9  request smuggling: gunicorn está expuesto directo      → corregir con la base
  4. CVE-2023-30861  Flask 1.0.2    cookie de sesión permanente filtrable por caché        → ventana de cambios
  5. CVE-2023-25577  Werkzeug 0.16  DoS por multipart: expuesto, impacto disponibilidad    → ventana de cambios
  Fuera del top: Pillow (decenas de CRITICAL/HIGH) — no se ejecuta; se elimina en B3.
EOF
  verde "bandera Rescate A: $F_AR"; guardar AR $F_AR ;;
 B) [ -n "$CT_MODO_FS" ] && { echo "(modo prueba)"; verde "bandera Rescate B: $F_BR"; guardar BR $F_BR; exit 0; }
    cp $EST/requirements.remediado.txt /root/lab6/carrito/requirements.txt
    echo "requirements.txt reemplazado por la versión remediada de referencia. Construyendo…"
    ct-construir && verde "bandera Rescate B: $F_BR" && guardar BR $F_BR ;;
 *) echo "uso: ct-rescate A | ct-rescate B" ;;
esac
