#!/bin/bash
# Lab 6 · Cóndor Tech · herramienta del escenario
EST=/root/lab6/.estado; mkdir -p "$EST"
verde(){ printf "\033[32m%s\033[0m\n" "$*"; }; rojo(){ printf "\033[31m%s\033[0m\n" "$*"; }; amar(){ printf "\033[33m%s\033[0m\n" "$*"; }; azul(){ printf "\033[36m%s\033[0m\n" "$*"; }
F_A1="CT{l6-a-min-48b974}"; F_A2="CT{l6-a-com-53bde8}"; F_A3="CT{l6-a-ext-06979c}"; F_AR="CT{l6-a-res-9aa817}"
F_B1="CT{l6-b-min-8837f9}"; F_B2="CT{l6-b-com-756d2f}"; F_B3="CT{l6-b-ext-0f2024}"; F_BR="CT{l6-b-res-1415cc}"
guardar(){ grep -q "^$1=" "$EST/banderas" 2>/dev/null || echo "$1=$2" >> "$EST/banderas"; }
# escaneo: en Killercoda es trivy image; CT_MODO_FS=<dir> permite probar la lógica sin docker
escanear_json(){ # $1 = tag (legacy|v2)
  local tag="$1" out="/root/lab6/escaneo-$1.json"
  if [ -n "$CT_MODO_FS" ]; then trivy fs --scanners vuln --format json -q "$CT_MODO_FS/$tag" > "$out" 2>/dev/null
  else trivy image --scanners vuln --format json -q "carrito:$tag" > "$out" 2>/dev/null; fi
  echo "$out"
}

id="$1"; shift; r="$(echo "$*" | tr 'a-z' 'A-Z' | tr -d ' ')"
[ -z "$id" ] || [ -z "$r" ] && { echo "uso: ct-responder a1|a2|a3 <respuesta>"; exit 2; }
case "$id" in
 a1) case "$r" in CVE-2020-14343|PYYAML)
        verde "✔ A1 mínimo: PyYAML 5.3.1 con yaml.load(FullLoader) sobre datos del cliente = ejecución remota de código desde internet, sin credenciales."
        verde "   bandera A1: $F_A1"; guardar A1 $F_A1
        echo "Siguiente (A2): ¿qué CVE del escaneo hace que el token de la pasarela de pagos termine en manos de un tercero? → ct-responder a2 CVE-..." ;;
      CVE-2020-35654|CVE-2021-*|CVE-2022-*|CVE-2023-4863|CVE-2023-44271|CVE-2023-50447|CVE-2024-28219|CVE-2026-54058) rojo "✘ Ese CVE es de Pillow: CVSS altísimo, pero ese código no se ejecuta en el carrito (ct-uso, línea 35). Riesgo ≠ CVSS." ;;
      CVE-2024-34069) rojo "✘ Casi: es de Werkzeug y permite ejecutar código, pero solo con el depurador de Werkzeug encendido, que en producción con gunicorn está apagado. Además es HIGH. Busca el CRITICAL en código que sí recibe datos del cliente." ;;
      CVE-2025-27516|CVE-2019-10906|CVE-2024-*) rojo "✘ Mira ct-uso: ese paquete casi no se ejecuta en el carrito o no recibe datos del cliente. Busca el CRITICAL que sí." ;;
      *) rojo "✘ No es ese. Pregunta: ¿qué paquete procesa datos que llegan de INTERNET sin credenciales y permite ejecutar código? Pista: ct-pista a1" ;;
     esac ;;
 a2) case "$r" in CVE-2018-18074)
        verde "✔ A2 completo: requests 2.19.1 reenvía la cabecera Authorization si la pasarela redirige de HTTPS a HTTP; el token de pagos viaja en claro a quien controle el destino."
        verde "   bandera A2: $F_A2"; guardar A2 $F_A2
        echo "Siguiente (A3): ¿qué paquete concentra más CRITICAL/HIGH y sin embargo NO debe entrar al top 5? → ct-responder a3 <paquete>" ;;
      CVE-2023-32681) rojo "✘ Casi: es de requests y filtra credenciales, pero solo la cabecera Proxy-Authorization cuando se usa un proxy. El carrito no usa proxy. Busca el de la redirección HTTPS→HTTP." ;;
      CVE-2024-47081) rojo "✘ Casi: es de requests, pero filtra credenciales guardadas en un archivo .netrc. El token del carrito va en la cabecera Authorization. Busca el de la redirección HTTPS→HTTP." ;;
      *) rojo "✘ No. El token lo lleva requests (ct-uso, línea 27). Mira ct-escanear legacy --paquete requests y busca el CVE de redirección HTTPS→HTTP. Pista: ct-pista a2" ;;
     esac ;;
 a3) case "$r" in PILLOW)
        verde "✔ A3 extra: Pillow trae decenas de hallazgos, pero FEATURE_MINIATURAS=0: ese código nunca se ejecuta. Se quita de la imagen, no se parcha (eso es el B3)."
        verde "   bandera A3: $F_A3"; guardar A3 $F_A3 ;;
      *) rojo "✘ No. Mira ct-escanear legacy --paquetes y cruza con la línea «No se usa» de ct-contexto." ;;
     esac ;;
 *) echo "uso: ct-responder a1|a2|a3 <respuesta>. El bloque B se verifica con ct-check." ;;
esac
