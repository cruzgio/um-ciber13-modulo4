#!/bin/bash
# Lab 6 · Cóndor Tech · herramienta del escenario
EST=/root/lab6/.estado; mkdir -p "$EST"
verde(){ printf "\033[32m%s\033[0m\n" "$*"; }; rojo(){ printf "\033[31m%s\033[0m\n" "$*"; }; amar(){ printf "\033[33m%s\033[0m\n" "$*"; }; azul(){ printf "\033[36m%s\033[0m\n" "$*"; }
cmd(){ if [ -t 1 ]; then printf "\033[36m  \$ %s\033[0m\n" "$*"; else printf "  \$ %s\n" "$*"; fi; }

tag="${1:-legacy}"; modo="$2"; pkg="$3"
uso(){ echo "uso: ct-escanear legacy|v2 [--paquetes | --top | --paquete <nombre>]"; exit 2; }
case "$tag" in legacy|v2) ;; *) uso;; esac
[ "$modo" = "--paquete" ] && [ -z "$pkg" ] && uso
[ -f $EST/db.ok ] || { amar "La base de CVE aún se está descargando. Espera y repite (ct-listo)."; exit 1; }
if [ -z "$CT_MODO_FS" ] && ! docker image inspect "carrito:$tag" >/dev/null 2>&1; then
  rojo "No existe la imagen carrito:$tag."; [ "$tag" = v2 ] && echo "Para crearla: edita /root/lab6/carrito/requirements.txt y ejecuta ct-construir"; exit 1
fi

J=/root/lab6/escaneo-$tag.json; T=/root/lab6/escaneo-$tag.txt
# El escaneo se hace UNA vez por imagen y se reutiliza (los modos solo cambian cómo se muestra)
if [ ! -s "$J" ] || [ -n "$CT_FORZAR" ] || [ "$(docker image inspect -f '{{.Id}}' carrito:$tag 2>/dev/null)" != "$(cat $J.id 2>/dev/null)" ]; then
  echo "▶ Esto es lo que se ejecuta por debajo:"
  if [ -n "$CT_MODO_FS" ]; then
    cmd "trivy fs --scanners vuln --format json -o $J $CT_MODO_FS/$tag"
    trivy fs --scanners vuln --format json -q -o "$J" "$CT_MODO_FS/$tag"
  else
    cmd "trivy image --scanners vuln --format json -o $J carrito:$tag"
    trivy image --scanners vuln --format json -q -o "$J" "carrito:$tag" || { rojo "Trivy falló. Revisa ct-listo."; exit 1; }
    docker image inspect -f '{{.Id}}' carrito:$tag > $J.id
  fi
  cmd "trivy convert --format table -o $T $J"
  trivy convert --format table -q -o "$T" "$J" 2>/dev/null
  echo
fi

case "$modo" in
 "")
  ct-formato resumen "$J" "$tag"
  echo
  echo "▶ Para ver el detalle (la salida completa no cabe en la pantalla):"
  echo "  ct-escanear $tag --paquetes        resumen por paquete de Python"
  echo "  ct-escanear $tag --top             los 12 de mayor CVSS"
  echo "  ct-escanear $tag --paquete flask   todos los CVE de un paquete"
  echo "  less -S $T   tabla completa (q sale)"
  ;;
 --paquetes)
  ct-formato paquetes "$J" "$tag"
  echo; echo "▶ Lo mismo, hecho a mano sobre el JSON:"
  cmd "jq -r '.Results[] | select(.Class==\"lang-pkgs\") | .Vulnerabilities[]? | \"\(.PkgName) \(.Severity)\"' $J | sort | uniq -c"
  ;;
 --top)
  ct-formato top "$J" "$tag"
  echo; echo "▶ Lo mismo, hecho a mano sobre el JSON:"
  cmd "jq -r '.Results[] | select(.Class==\"lang-pkgs\") | .Vulnerabilities[]? | \"\(.CVSS.nvd.V3Score) \(.VulnerabilityID) \(.PkgName)\"' $J | sort -rn | head -12"
  ;;
 --paquete)
  ct-formato paquete "$J" "$tag" "$pkg"
  echo; echo "▶ Lo mismo, hecho a mano:"
  cmd "jq -r '.Results[].Vulnerabilities[]? | select(.PkgName|ascii_downcase==\"$pkg\") | \"\\(.VulnerabilityID) \\(.Severity) \\(.FixedVersion)\"' $J"
  ;;
 *) uso ;;
esac
