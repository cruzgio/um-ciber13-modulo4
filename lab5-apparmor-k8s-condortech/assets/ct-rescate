#!/bin/bash
LAB=/root/lab5
PERFIL=/etc/apparmor.d/opt.condor.leer-config
APP=/opt/condor/leer-config
B_A1="CT{l5-a-min-4e7b2a}"; B_A2="CT{l5-a-com-91d3f6}"; B_A3="CT{l5-a-ext-c58a17}"; B_AR="CT{l5-a-res-2b6e90}"
B_B1="CT{l5-b-min-7a3c1d}"; B_B2="CT{l5-b-com-e24f88}"; B_B3="CT{l5-b-ext-5d9b3c}"; B_BR="CT{l5-b-res-a71e42}"
verde(){ printf '\033[32m%s\033[0m\n' "$*"; }
rojo(){ printf '\033[31m%s\033[0m\n' "$*"; }
amar(){ printf '\033[33m%s\033[0m\n' "$*"; }
eco(){ printf '\033[2m   $ %s\033[0m\n' "$*"; }   # muestra el comando real que la herramienta ejecuta
guardar(){ grep -q "$2" $LAB/.banderas 2>/dev/null || echo "$1 $2" >> $LAB/.banderas; }
modo_perfil(){ # imprime complain | enforce | ninguno
  if aa-status 2>/dev/null | awk '/profiles are in enforce mode/{f=1;next} /profiles are in/{f=0} f' | grep -q 'opt/condor/leer-config'; then echo enforce
  elif aa-status 2>/dev/null | awk '/profiles are in complain mode/{f=1;next} /profiles are in/{f=0} f' | grep -q 'opt/condor/leer-config'; then echo complain
  else echo ninguno; fi; }

case "$1" in
A|a)
  eco "cp /root/lab5/perfil-rescate $PERFIL"
  eco "apparmor_parser -r $PERFIL                  (enforce)"
  cp /root/lab5/perfil-rescate $PERFIL && apparmor_parser -r $PERFIL
  amar "Rescate A aplicado: perfil completo en enforce. Comprueba:  $APP --config ; $APP --secreto ; ct-denegaciones"
  verde "bandera Rescate A: $B_AR"; guardar A-Rescate $B_AR ;;
B|b)
  eco "kubectl delete pod carrito-legacy carrito -n tienda --ignore-not-found"
  eco "kubectl apply -f /root/lab5/carrito-rescate.yaml && kubectl wait --for=condition=Ready pod/carrito -n tienda"
  kubectl delete pod carrito-legacy carrito -n tienda --ignore-not-found >/dev/null 2>&1
  kubectl apply -f /root/lab5/carrito-rescate.yaml >/dev/null && kubectl wait --for=condition=Ready pod/carrito -n tienda --timeout=90s >/dev/null 2>&1
  amar "Rescate B aplicado: carrito endurecido desplegado (lee /root/lab5/carrito-rescate.yaml, es tu referencia para el artefacto)."
  verde "bandera Rescate B: $B_BR"; guardar B-Rescate $B_BR ;;
*) echo "uso: ct-rescate A | ct-rescate B" ;;
esac
