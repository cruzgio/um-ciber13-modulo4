#!/usr/bin/env bash
source /opt/ct/lib.sh
titulo "Tus banderas de esta sesión"
if [ ! -s "$MIS" ]; then
  echo "  Todavía no capturaste ninguna. Empezá con:  ct-alertas escaneo.pcap"; echo; exit 0
fi
while IFS=$'\t' read -r reto flag; do
  [ -z "$flag" ] && continue
  echo "  ${C_NOTA}categoría «${CT_CATEGORIA}» → reto «${C_B}${reto}${C_N}»"
  echo "     ${C_B}${flag}${C_N}"; echo
done < "$MIS"
echo "  Cada bandera va al reto de CTFd que lleva ESE mismo nombre."
echo "  Copialas ahora: cuando la sesión se cierre, esto se pierde."; echo
