# ═════════════════════════════════════════════════════════════════════════
#  BANDERAS DEL LAB 3 · Cóndor Tech · Módulo 4 CIBER13
# ═════════════════════════════════════════════════════════════════════════
#
#  ESTAS BANDERAS YA ESTÁN LISTAS. No hay que inventar nada.
#  Solo se cambian si reutilizas el lab con otra cohorte: cambia el bloque
#  de seis letras/números del final y vuelve a cargarlas en CTFd (cat. "Lab 3").
#
#  DOBLE NIVEL, como todo el módulo:
#   · MÍNIMO  = leer la alerta obvia que el IDS ya te dio (fast.log).
#   · COMPLETO = trabajo de analista: priorizar, y encontrar lo que el IDS
#                NO te dio (mirar el pcap con tshark, cazar con jq).
#
#  3.1 a 3.3 son DATOS que se descubren; ct-bandera los entrega con formato.
#  3.4 (regla propia) lo verifica ct-check, porque no es un dato: tiene
#  que FUNCIONAR. Quien llega a completo recibe DOS banderas (se suman).
# ═════════════════════════════════════════════════════════════════════════

CT_CATEGORIA='Lab 3'

# ── 3.1 · El escaneo ─────────────────────────────────────────────────────
#  Mínimo: SID de la regla ET que cantó
CT_FLAG_31_MIN='CT{2010935}'
CT_RETO_31_MIN='3.1 El escaneo'
#  Completo: el IDS alertó por UN puerto, pero el escaneo tocó ~20.
#  ¿Qué activo:puerto encontró abierto el atacante y siguió golpeando?
CT_FLAG_31_FULL='CT{192.168.20.10:1433}'
CT_RETO_31_FULL='3.1 El activo golpeado'

# ── 3.2 · El MitM cantado ────────────────────────────────────────────────
#  Mínimo: SID local que cantó la credencial en claro
CT_FLAG_32_MIN='CT{9000001}'
CT_RETO_32_MIN='3.2 El MitM cantado'
#  Completo: lo que el IDS NO vio. Suricata ignora ARP; el ataque real
#  (la suplantación del gateway) es invisible. ¿Cuál es la MAC que suplantó
#  al gateway, que tuviste que sacar del pcap porque el IDS no la reportó?
CT_FLAG_32_FULL='CT{02:00:00:de:ad:66}'
CT_RETO_32_FULL='3.2 El punto ciego'

# ── 3.3 · El C2 ──────────────────────────────────────────────────────────
#  Mínimo: IP del C2 (a dónde hace beacon el equipo infectado)
CT_FLAG_33_MIN='CT{203.0.113.66}'
CT_RETO_33_MIN='3.3 El C2'
#  Completo: el dominio malicioso que resolvió antes de llamar al C2 (jq DNS)
CT_FLAG_33_FULL='CT{cdn-updates-pool.top}'
CT_RETO_33_FULL='3.3 El dominio'

# ── 3.4 · Tu propia detección (checker) ──────────────────────────────────
CT_FLAG_34_MIN='CT{lab3_reglapropia_7ac419}'
CT_RETO_34_MIN='3.4 Regla propia'
CT_FLAG_34_FULL='CT{lab3_triaje_e02b8d}'
CT_RETO_34_FULL='3.4 Regla + triaje'
CT_FLAG_34_RESCATE='CT{lab3_rescate_5f9d20}'
CT_RETO_34_RESCATE='3.4 Rescate'
