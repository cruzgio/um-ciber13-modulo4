#!/bin/bash
# ct-retomar <bandera> — reconstruye el estado del Bloque A para arrancar el Bloque B sin repetir pasos.
. /usr/local/bin/ct-comun
esperar_listo
case "$1" in
 "$F_A1"|"$F_A2"|"$F_AR") ;;
 *) no "Bandera no válida. Uso: ct-retomar <bandera A Mínimo, A Completo o A Rescate>"; exit 1;;
esac
info "Bandera aceptada. Reconstruyendo el estado del Bloque A:"
if [ ! -f $E/config/erp.conf ]; then
  if restic -r $REPO_A -p $LLAVE snapshots >/dev/null 2>&1; then
    run "rm -rf $E"; run "restic -r $REPO_A -p $LLAVE restore latest --target / >/dev/null" && ok "Datos del ERP restaurados desde $REPO_A"
  elif restic -r $REPO_B -p $LLAVE snapshots >/dev/null 2>&1; then
    run "rm -rf $E"; run "restic -r $REPO_B -p $LLAVE restore latest --target / >/dev/null" && ok "Datos del ERP restaurados desde la copia inmutable"
  fi
fi
[ -f $E/config/erp.conf ] || { no "No hay datos ni respaldo utilizable; ejecuta ct-rescate A"; exit 1; }
run "find $E -name '*.locked' -delete"; run "rm -f $E/NOTA_DE_RESCATE.txt"
if ! restic -r $REPO_A -p $LLAVE snapshots >/dev/null 2>&1; then
  [ -d $REPO_A ] && run "rm -rf $REPO_A"
  run "restic -r $REPO_A -p $LLAVE init >/dev/null" && run "restic -r $REPO_A -p $LLAVE backup $E >/dev/null" && ok "Repositorio local del Bloque A listo"
fi
touch $CT/bloque_a_ok
ok "Estado listo. Sigue con el Bloque B: ct-pista b1"
