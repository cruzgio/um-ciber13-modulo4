#!/usr/bin/env bash
# ct-retomar <bandera> [<bandera> ...] — entra al Bloque B (por ejemplo, en una sesión nueva después de la pausa).
# Con cualquier bandera del Bloque A aplica el mínimo de los checkpoints 1 y 2.
# Con 8.1c y/o 8.2c repone también el nivel completo de ese checkpoint (ya lo ganaste).
# Lo que se aplica sin la bandera correspondiente cuenta como rescate de ese checkpoint.
[ $# -ge 1 ] || { echo "Uso: ct-retomar <bandera> [<bandera> ...]   (pega todas tus banderas del Bloque A)"; exit 2; }
ok=0; c1=0; c2=0; f1=0; f2=0
for b in "$@"; do case "$b" in
  "CT{cuentas-endurecidas-4e1a}"|"CT{rescate-cuentas-1c5e}") ok=1; f1=1;;
  "CT{pam-exige-y-bloquea-9b2d}") ok=1; f1=1; c1=1;;
  "CT{superficie-cerrada-7c9d}"|"CT{rescate-superficie-6d0b}") ok=1; f2=1;;
  "CT{ssh-y-secretos-a8f3}") ok=1; f2=1; c2=1;;
  *) echo "No reconozco '$b' como bandera del Bloque A (se ignora).";;
esac; done
[ $ok -eq 1 ] || { echo "Ninguna bandera válida del Bloque A. Si no tienes ninguna: 'ct-rescate 1' y luego 'ct-check 1'."; exit 1; }
# ¿el mínimo de cada checkpoint ya está hecho en ESTE servidor?
m1=1; awk -F: '$1=="soporte"{print $2}' /etc/shadow | grep -qE '^[!*]' || m1=0
grep -RqE '^[[:space:]]*soporte[[:space:]]' /etc/sudoers.d/ 2>/dev/null && m1=0
m2=1; ss -H -tln | grep -qE ':2323[[:space:]]' && m2=0
[ $(( $(stat -c '%a' /etc/shadow) % 10 )) -ne 0 ] && m2=0
# sin la bandera del checkpoint y sin haberlo hecho aquí -> cuenta como rescate
[ $m1 -eq 0 ] && [ $f1 -eq 0 ] && touch /opt/checker/rescate_1
[ $m2 -eq 0 ] && [ $f2 -eq 0 ] && touch /opt/checker/rescate_2
# mínimo de ambos checkpoints
awk -F: '$1=="soporte"{print $2}' /etc/shadow | grep -qE '^[!*]' || passwd -l soporte >/dev/null
rm -f /etc/sudoers.d/90-condor
systemctl disable --now condor-legacy >/dev/null 2>&1 || kill $(ss -H -tlnp 'sport = :2323' | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u) 2>/dev/null || true
chown root:shadow /etc/shadow; chmod 640 /etc/shadow
msg="el mínimo de los checkpoints 1 y 2"
if [ $c1 -eq 1 ]; then
  grep -qE '^[[:space:]]*minlen[[:space:]]*=[[:space:]]*(1[4-9]|[2-9][0-9])' /etc/security/pwquality.conf || echo 'minlen = 14' >> /etc/security/pwquality.conf
  grep -qE '^[^#]*pam_faillock\.so' /etc/pam.d/common-auth || sed -i '1i auth required pam_faillock.so preauth silent deny=5 unlock_time=900' /etc/pam.d/common-auth
  msg="$msg, el completo del checkpoint 1"; fi
if [ $c2 -eq 1 ]; then
  chmod o-w /opt/app/config/backup.sh 2>/dev/null
  sed -i 's/^PermitRootLogin.*/PermitRootLogin no/;s/^PermitEmptyPasswords.*/PermitEmptyPasswords no/' /etc/ssh/sshd_config
  msg="$msg, el completo del checkpoint 2"; fi
echo "Listo: quedó aplicado $msg."
echo "Revisa con ct-estado y sigue con el Bloque B: lynis audit system --quick  y luego  ct-check 3"
